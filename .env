# Amazon Login with Amazon (LWA) OAuth 2.0 Credentials
AMAZON_CLIENT_ID=amzn1.application-oa2-client.your_client_id_here
AMAZON_CLIENT_SECRET=your_amazon_client_secret_here
AMAZON_REDIRECT_URI=http://localhost:8000/auth/amazon/callback
AMAZON_LWA_AUTHORIZATION_URL=https://www.amazon.com/ap/oa
AMAZON_LWA_TOKEN_URL=https://api.amazon.com/auth/o2/token

# Amazon Data Portability API Configuration
AMAZON_DATA_PORTABILITY_BASE_URL=https://api.amazon.com/data-portability
AMAZON_DATA_PORTABILITY_SCOPE=amazon:data_portability:physical_orders

# Prototype Mock Mode (Set to true to test UI & flow offline with realistic mock data)
AMAZON_MOCK_MODE=true

# Frontend URL
FRONTEND_URL=http://localhost:5173
